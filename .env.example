# Copy to .env and fill locally. .env is ignored by Git.
# Start the protected local pilot with npm run dev:meta.
MODEL_API_KEY=
META_API_URL=https://api.meta.ai/v1/chat/completions
META_MODEL=muse-spark-1.3
META_AUTH_PASSWORD=
# Used by Copilot chat, journey interpretation and notice translation.
# Choose a tool-capable Model APIs model slug available in your Baseten account.
BASETEN_API_KEY=
BASETEN_MODEL=

# meta (default) or baseten. The other configured provider is the fallback.
MODEL_PRIMARY_PROVIDER=meta
# Set false to use only the first available configured provider.
MODEL_FALLBACK_ENABLED=true
